*{
    margin: 0;
    padding: 0; 
    box-sizing: border-box;
    text-decoration: none;  
    border: none;
    outline: none;   
    scroll-behavior: smooth;
    font-family: "Poppins", sans-serif;
}

:root{
    --bg-color: #000000;
    --second-bg-color: #131313;
    --text-color: #fff;
    --main-color: #d8cefd  ;
    --main-color2: #B3B3F1;
}

html{
    font-size: 60%;
    overflow-x: hidden;
}

body{
    background-color: var(--bg-color);
    color: var(--text-color);
}

.header{
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 4rem 12% 4rem;
    background: rgba(0,0,0,0.1);
    backdrop-filter: blur(20px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 5;
    max-height: 100px;
}

.logo{
    font-size: 3rem;
    color: var(--text-color);
    font-weight: 800;
    cursor: pointer;
    transition: 0.3s ease;
}

.logo:hover{
    transform: scale(1.1);
}

.logo span{
    text-shadow: 0 0 25px var(--main-color);
}

.navbar a{
    font-size: 1.8rem;
    color: var(--text-color);
    margin-left: 4rem;
    font-weight: 600;   
    transition: 0.3s ease;
    border-bottom: .5px solid transparent; 
}

.navbar a:hover,
.navbar a.active{
    color: var(--main-color2);
    border-bottom: .5px solid var(--main-color2);
}

#menu-icon{
    display: none;
    font-size: 3.5rem;
    color: var(--main-color2);
    cursor: pointer;
}
section{
    min-height: 100vh;
    padding:10rem 12% 10rem;
}
.home{
    display:flex;
    align-items: center;
    justify-content:center;
    gap: 15rem;
}

.home-content{
    display: flex; 
    flex-direction: column;
    align-items: center;
    text-align:center;
    justify-content: center;
    margin-top: 5rem;
}
span{
    color: var(--main-color);
}
.logo span{
    color: var(--main-color2);
}

.home-content h3{
    font-family: "Orbitron", sans-serif;
    margin-bottom: 2rem;
    margin-top: 1rem;
    font-size: 3.5rem;
}

.home-content h1{
    font-size: 5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    line-height: 1;
}

.home-img-container{
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.home-img{
    border-radius: 50%;
    position: relative;
    z-index: 1;
}

.home-img img{
    width: 20vw;
    border-radius: 50%;
    box-shadow: 0 0 50px var(--main-color);
    cursor:pointer;
    transition: 0.4s ease-in-out;
    min-width: 200px;
}

.home-img img:hover{
    transform: scale(1.1);
    box-shadow: 0 0 5px var(--main-color);    
}

.home-content p{
    font-size: 2rem;
    font-weight: 500;
    margin-top: 0.5rem;
    line-height: 1.5;
    max-width: 1000px;
}

.social-icons{
    display: flex;
    flex-direction: column;
    margin-left: 2rem;
    position: absolute;
    right: -5rem;
    top: 50%;
    transform: translateY(-50%);
}

.social-icons a{
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 4.5rem;
    height: 4.5rem;
    background: transparent;
    font-size: 2.5rem;
    color: var(--main-color);
    margin-bottom: 1rem;
    transition: 0.3s ease-in-out;
    padding-left: 0;
}

.social-icons a:hover{
    color: var(--text-color );
    transform: scale(1.3) translateX(2rem);
   
    
}
.social-icons a:nth-child(2),
.social-icons a:nth-child(3){
    padding-left: 2rem; 
}

.btn{
    display: inline-block;
    padding: 1rem 2.8rem;
    background: var(--main-color);
    box-shadow: 0 0 25px var(--main-color);
    border-radius: 4rem;
    font-size: 1.6rem;
    color: black;
    border: 2px solid transparent;
    letter-spacing: 0.1rem;
    font-weight: 600;
    transition:0.3s ease-in-out;
    cursor: pointer;
}

.btn:hover{
    transform: scale(1.05);
    box-shadow: 0 0 50px var(--main-color);
}

.btn-group{
    display: flex;
    align-items:center;
    gap: 1.5rem;
    margin-top:  2rem;
}

.btn-group a:nth-of-type(2){
    background-color: black;
    color: var(--main-color);
    border: 2px solid var(--main-color);
    box-shadow: 0 0 25px transparent;
}

.btn-group a:nth-of-type(2):hover{
    background-color: var(--main-color);
    color: black;
    box-shadow: 0 0 25px var(--main-color);
}
.text-animation{
    font-size: 34px;
    font-weight: 600;
    min-width: 280px;
}

.text-animation span{
    position: relative;
}

.text-animation span::before{
    font-family: "Orbitron", sans-serif;
    content: "Web Developer";
    color: var(--main-color2);
    animation: words 20s infinite;
}

.text-animation span::after{
    content: "";
    background-color: var(--bg-color);
    position: aboslute;
    width: calc(100% +8px);
    height: 100%;
    border-left: 3px solid var(--bg-color);
    right: -8px;
    animation: cursor 0.6s infinite, typing 20s steps(14) infinite;
}
@keyframes cursor{
    to{
        border-left: 3px solid var(--main-color);
    }
}


@keyframes words{
    0%,
    20%{
        content: "Frontend Designer";
    }
